# SwasthyaSync Main Kiosk & Clinician Backend Environment Example

# AI & Speech APIs
GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional keyless mode (Vertex AI / Agent Platform via the Cloud Run service account).
# Used only when GEMINI_API_KEY is empty.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Gemini models (comma-separated; first = primary, rest = fallbacks). See backend/model_config.py
GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_REASONING_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_VISION_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Gemini Live voice (low latency): live = Live with automatic STT/TTS fallback; legacy = STT/TTS only
VOICE_MODE=live
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Max seconds to wait for Live to start speaking / reply before falling back
GEMINI_LIVE_TIMEOUT=20
# Database connect timeout in seconds (raise on slow networks)
DB_CONNECT_TIMEOUT=20
# Speech-to-text: sarvam (default: Sarvam saaras:v3 first, Gemini Transcribe as backup) or google
STT_PROVIDER=sarvam
# Text-to-speech: google (default: Gemini TTS, Sarvam backup if SARVAM_API_KEY is set) or sarvam
SPEECH_PROVIDER=google
GEMINI_TTS_VOICE=Kore
# Per-call AI time limits in seconds (raise on slow Wi-Fi to avoid generic fallback questions)
GEMINI_FAST_TIMEOUT=12
GEMINI_REASONING_TIMEOUT=20
GEMINI_SCHEMA_TIMEOUT=25
# Constrain JSON outputs with response_json_schema (false = prompt-only JSON)
GEMINI_STRICT_JSON_SCHEMA=true
# OCR identity check: "python" (default, patient name never sent to the model) or "llm"
OCR_NAME_MATCH_MODE=python

# Database: any Postgres DSN (AlloyDB or Supabase). SUPABASE_DB_URL still works as a fallback.
# If your network blocks port 5432, use Supabase's pooler port 6543 instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Optional AlloyDB connector mode (instead of a DSN host): projects/P/locations/asia-south1/clusters/C/instances/I
ALLOYDB_INSTANCE_URI=
ALLOYDB_IP_TYPE=PUBLIC
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=
ALLOYDB_DB=postgres

# Private Cloud Storage bucket for patient documents (unset = local backend/uploads, dev only)
GCS_BUCKET=

# CORS: comma-separated allowed origins (production: Firebase Hosting URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin account created/updated at startup (password from Secret Manager in production)
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# Legacy Supabase (only SUPABASE_DB_URL is still read, as a DATABASE_URL fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# OTP Provider Configuration
# Set to 'fast2sms' for real India SMS or 'mock' for local development
OTP_PROVIDER=mock
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_OTP_TEMPLATE_ID=your_dlt_template_id_here
FAST2SMS_SENDER_ID=SWASTH
OTP_TEST_MODE=false
OTP_DISABLE_RATE_LIMIT=true
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_PHONE_WINDOW=3
OTP_SEND_WINDOW_SECONDS=900
